<!doctype html>
<html lang="es">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Proyectos Integradores - Home</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/home.css">
</head>

<body class="bg-light">
  <!-- Cabecera -->
  <header class="bg-primary text-white py-5">
    <div class="container text-center">
      <h1 class="display-4 fw-bold">Proyectos Integradores 2025</h1>
      <p class="lead">Jornada de Sustentaciones de Proyectos</p>
    </div>
  </header>

  <!-- Menú -->
  <%- include('menu') %>

  <!-- Contenido Principal -->
  <main class="container my-5">
    <!-- ¿Qué son Proyectos Integradores? -->
    <section class="mb-5">
      <div class="row">
        <div class="col-lg-8 mx-auto">
          <div class="card shadow-sm">
            <div class="card-body p-4">
              <h2 class="card-title text-primary mb-4">¿Qué son los Proyectos Integradores?</h2>
              <p class="card-text">
                Los Proyectos Integradores son trabajos académicos que permiten a los estudiantes aplicar los conocimientos 
                adquiridos durante su formación universitaria en la solución de problemas reales. Estos proyectos fomentan 
                el trabajo en equipo, la creatividad y la innovación tecnológica.
              </p>
              <p class="card-text">
                En esta jornada, los grupos de estudiantes presentarán sus desarrollos en diversas áreas como Ingeniería 
                de Software, Ciencia de Datos, Inteligencia Artificial, Seguridad Informática y más.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Agenda de la Jornada -->
    <section class="mb-5">
      <h2 class="text-center text-primary mb-4">Agenda Oficial de la Jornada</h2>
      <div class="row">
        <div class="col-lg-11 mx-auto">
          <div class="card shadow-sm">
            <div class="card-body p-0">
              <!-- Pestañas de Navegación -->
              <ul class="nav nav-tabs nav-fill" id="agendaTabs" role="tablist">
                <li class="nav-item" role="presentation">
                  <button class="nav-link active" id="dia1-tab" data-bs-toggle="tab" data-bs-target="#dia1" 
                    type="button" role="tab" aria-controls="dia1" aria-selected="true">
                    28 de Octubre
                  </button>
                </li>
                <li class="nav-item" role="presentation">
                  <button class="nav-link" id="dia2-tab" data-bs-toggle="tab" data-bs-target="#dia2" 
                    type="button" role="tab" aria-controls="dia2" aria-selected="false">
                    29 de Octubre
                  </button>
                </li>
                <li class="nav-item" role="presentation">
                  <button class="nav-link" id="dia3-tab" data-bs-toggle="tab" data-bs-target="#dia3" 
                    type="button" role="tab" aria-controls="dia3" aria-selected="false">
                    30 de Octubre
                  </button>
                </li>
              </ul>

              <!-- Contenido de las Pestañas -->
              <div class="tab-content p-3" id="agendaTabContent">
                <!-- Día 1: 28 de Octubre -->
                <div class="tab-pane fade show active" id="dia1" role="tabpanel" aria-labelledby="dia1-tab">
                  <div class="text-center mb-3">
                    <h5 class="text-primary">Jornada del 28 de Octubre de 2025</h5>
                    <p class="text-muted small mb-2">Agenda oficial de las sustentaciones</p>
                    <!-- Botón de descarga para móviles -->
                    <a href="/img/JSPI-28-oct-2025.pdf" download class="btn btn-sm btn-outline-primary d-md-none">
                      Descargar PDF
                    </a>
                  </div>
                  <!-- Visor PDF -->
                  <div class="ratio ratio-16x9" style="min-height: 600px;">
                    <iframe src="/img/JSPI-28-oct-2025.pdf" 
                      title="Agenda 28 de Octubre 2025"
                      class="border rounded"
                      style="height: 700px;">
                      <p>Su navegador no puede mostrar PDFs. 
                        <a href="/img/JSPI-28-oct-2025.pdf" download>Descargue el PDF aquí</a>
                      </p>
                    </iframe>
                  </div>
                </div>

                <!-- Día 2: 29 de Octubre -->
                <div class="tab-pane fade" id="dia2" role="tabpanel" aria-labelledby="dia2-tab">
                  <div class="text-center mb-3">
                    <h5 class="text-primary">Jornada del 29 de Octubre de 2025</h5>
                    <p class="text-muted small mb-2">Agenda oficial de las sustentaciones</p>
                    <!-- Botón de descarga para móviles -->
                    <a href="/img/JSPI-29-oct-2025.pdf" download class="btn btn-sm btn-outline-primary d-md-none">
                      Descargar PDF
                    </a>
                  </div>
                  <!-- Visor PDF -->
                  <div class="ratio ratio-16x9" style="min-height: 600px;">
                    <iframe src="/img/JSPI-29-oct-2025.pdf" 
                      title="Agenda 29 de Octubre 2025"
                      class="border rounded"
                      style="height: 700px;">
                      <p>Su navegador no puede mostrar PDFs. 
                        <a href="/img/JSPI-29-oct-2025.pdf" download>Descargue el PDF aquí</a>
                      </p>
                    </iframe>
                  </div>
                </div>

                <!-- Día 3: 30 de Octubre -->
                <div class="tab-pane fade" id="dia3" role="tabpanel" aria-labelledby="dia3-tab">
                  <div class="text-center mb-3">
                    <h5 class="text-primary">Jornada del 30 de Octubre de 2025</h5>
                    <p class="text-muted small mb-2">Agenda oficial de las sustentaciones</p>
                    <!-- Botón de descarga para móviles -->
                    <a href="/img/JSPI-30-oct-2025.pdf" download class="btn btn-sm btn-outline-primary d-md-none">
                      Descargar PDF
                    </a>
                  </div>
                  <!-- Visor PDF -->
                  <div class="ratio ratio-16x9" style="min-height: 600px;">
                    <iframe src="/img/JSPI-30-oct-2025.pdf" 
                      title="Agenda 30 de Octubre 2025"
                      class="border rounded"
                      style="height: 700px;">
                      <p>Su navegador no puede mostrar PDFs. 
                        <a href="/img/JSPI-30-oct-2025.pdf" download>Descargue el PDF aquí</a>
                      </p>
                    </iframe>
                  </div>
                </div>
              </div>

              <!-- Información adicional -->
              <div class="card-footer bg-light text-center">
                <small class="text-muted">
                  <strong>Tip:</strong> Usa los controles del visor para hacer zoom, descargar o imprimir la agenda.
                  En dispositivos móviles, descarga el PDF para mejor visualización.
                </small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Botones de Navegación Rápida -->
    <section class="mb-5">
      <h2 class="text-center text-primary mb-4">Navegación Rápida</h2>
      <div class="row g-4">
        <div class="col-md-4">
          <div class="card h-100 shadow-sm hover-card">
            <div class="card-body text-center">
              <div class="display-4 mb-3"></div>
              <h5 class="card-title">Todas las Sustentaciones</h5>
              <p class="card-text">Explora todos los proyectos presentados en la jornada</p>
              <a href="/sustentaciones" class="btn btn-primary">Ver Sustentaciones</a>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100 shadow-sm hover-card">
            <div class="card-body text-center">
              <div class="display-4 mb-3"></div>
              <h5 class="card-title">Proyectos Destacados</h5>
              <p class="card-text">Descubre los proyectos más relevantes e innovadores</p>
              <a href="/sustentaciones/destacadas" class="btn btn-warning">Ver Destacadas</a>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100 shadow-sm hover-card">
            <div class="card-body text-center">
              <div class="display-4 mb-3"></div>
              <h5 class="card-title">Registrar Proyecto</h5>
              <p class="card-text">¿Tienes un proyecto? Regístralo aquí</p>
              <a href="/sustentaciones/registro" class="btn btn-success">Registrar Ahora</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Pie de Página -->
  <footer class="bg-dark text-white py-4 mt-5">
    <div class="container text-center">
      <p class="mb-0">© 2025 Proyectos Integradores - UPB BGA</p>
      <p class="mb-0 small">Jornada de Sustentaciones Académicas</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>
</body>

</html>