<!doctype html>
<html lang="es">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sustentaciones Destacadas - Proyectos Integradores</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/destacadas.css">
</head>

<body class="bg-light">
  <!-- Cabecera -->
  <header class="bg-warning text-dark py-4">
    <div class="container text-center">
      <h1 class="display-5 fw-bold">Sustentaciones Destacadas</h1>
      <p class="lead">Los proyectos más relevantes e innovadores</p>
    </div>
  </header>

  <!-- Menú -->
  <%- include('menu') %>

  <!-- Contenido Principal -->
  <main class="container my-5">
    <% if (destacadas.length === 0) { %>
      <div class="alert alert-warning text-center">
        <h4>No hay sustentaciones destacadas en este momento</h4>
        <p>Vuelve pronto para descubrir los proyectos más relevantes</p>
        <a href="/sustentaciones" class="btn btn-primary mt-3">Ver Todas las Sustentaciones</a>
      </div>
    <% } else { %>
      <!-- Descripción -->
      <section class="mb-5">
        <div class="row">
          <div class="col-lg-10 mx-auto">
            <div class="alert alert-warning text-center">
              <p class="mb-0">
                <strong>¡Estos son los <%= destacadas.length %> proyectos seleccionados como destacados!</strong> 
                Usa las flechas o desliza para navegar entre los proyectos.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Carrusel de Proyectos Destacados -->
      <section>
        <div id="carouselDestacadas" class="carousel slide" data-bs-ride="carousel">
          <!-- Indicadores -->
          <div class="carousel-indicators">
            <% destacadas.forEach((sustentacion, index) => { %>
              <button type="button" data-bs-target="#carouselDestacadas" data-bs-slide-to="<%= index %>" 
                class="<%= index === 0 ? 'active' : '' %>" 
                aria-current="<%= index === 0 ? 'true' : 'false' %>" 
                aria-label="Slide <%= index + 1 %>">
              </button>
            <% }) %>
          </div>

          <!-- Slides del Carrusel -->
          <div class="carousel-inner">
            <% destacadas.forEach((sustentacion, index) => { %>
              <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                <div class="row justify-content-center">
                  <div class="col-lg-8 col-md-10">
                    <div class="card shadow-lg border-warning border-3">
                      <!-- Imagen -->
                      <div class="position-relative">
                        <img src="/img/<%= sustentacion.imagen %>" 
                          class="card-img-top" 
                          alt="<%= sustentacion.nombreGrupo %>"
                          style="max-height: 400px; object-fit: cover;">
                        <!-- Badge de posición -->
                        <span class="position-absolute top-0 start-0 m-3">
                          <span class="badge bg-warning text-dark fs-3">
                            #<%= index + 1 %>
                          </span>
                        </span>
                        <!-- Badge destacado -->
                        <span class="position-absolute top-0 end-0 m-3">
                          <span class="badge bg-success fs-5">
                            DESTACADO
                          </span>
                        </span>
                      </div>

                      <!-- Contenido -->
                      <div class="card-body p-4">
                        <!-- Título y Materia -->
                        <div class="text-center mb-4">
                          <h2 class="card-title text-warning fw-bold mb-3">
                            <%= sustentacion.nombreGrupo %>
                          </h2>
                          <span class="badge bg-primary fs-6 mb-3">
                            <%= sustentacion.materia %>
                          </span>
                        </div>

                        <!-- Descripción -->
                        <div class="mb-4">
                          <h5 class="text-secondary mb-2">Descripción del Proyecto</h5>
                          <p class="card-text lead">
                            <%= sustentacion.descripcion %>
                          </p>
                        </div>

                        <!-- Comentarios Docentes -->
                        <% if (sustentacion.contenido && sustentacion.contenido.trim()) { %>
                          <div class="mb-4">
                            <h5 class="text-secondary mb-2">Comentarios Docentes</h5>
                            <p class="card-text fst-italic">
                              <%= sustentacion.contenido %>
                            </p>
                          </div>
                        <% } %>

                        <!-- Integrantes -->
                        <div class="mb-4">
                          <h5 class="text-secondary mb-3">Integrantes del Equipo</h5>
                          <div class="row g-2">
                            <% sustentacion.integrantes.forEach(integrante => { %>
                              <div class="col-md-6">
                                <div class="alert alert-light mb-0 py-2">
                                  <small><%= integrante %></small>
                                </div>
                              </div>
                            <% }) %>
                          </div>
                        </div>

                        <!-- Botón Ver Detalle -->
                        <div class="text-center">
                          <a href="/sustentaciones/<%= sustentacion.id %>" 
                            class="btn btn-warning btn-lg fw-bold px-5">
                            Ver Proyecto Completo →
                          </a>
                        </div>
                      </div>

                      <!-- Footer con contador -->
                      <div class="card-footer bg-warning text-dark text-center">
                        <small class="fw-bold">
                          Proyecto <%= index + 1 %> de <%= destacadas.length %> destacados
                        </small>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>

          <!-- Controles de Navegación -->
          <button class="carousel-control-prev" type="button" data-bs-target="#carouselDestacadas" data-bs-slide="prev">
            <span class="carousel-control-prev-icon bg-warning rounded-circle p-3" aria-hidden="true"></span>
            <span class="visually-hidden">Anterior</span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#carouselDestacadas" data-bs-slide="next">
            <span class="carousel-control-next-icon bg-warning rounded-circle p-3" aria-hidden="true"></span>
            <span class="visually-hidden">Siguiente</span>
          </button>
        </div>

        <!-- Instrucciones de Navegación -->
        <div class="text-center mt-4">
          <small class="text-muted">
            <strong>Tip:</strong> Usa las flechas laterales, los puntos indicadores o las teclas ←→ para navegar
          </small>
        </div>
      </section>

      <!-- Botón para ver todas -->
      <section class="mt-5 text-center">
        <a href="/sustentaciones" class="btn btn-primary btn-lg">
          Ver Todas las Sustentaciones
        </a>
      </section>
    <% } %>
  </main>

  <!-- Pie de Página -->
  <footer class="bg-dark text-white py-4 mt-5">
    <div class="container text-center">
      <p class="mb-0">© 2025 Proyectos Integradores - UPB BGA</p>
      <p class="mb-0 small">Jornada de Sustentaciones Académicas</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>
</body>

</html>
