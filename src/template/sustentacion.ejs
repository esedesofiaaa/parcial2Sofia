<!doctype html>
<html lang="es">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= sustentacion.nombreGrupo %> - Proyectos Integradores</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/sustentacion-detail.css">
</head>

<body class="bg-light">
  <!-- Cabecera -->
  <header class="bg-info text-white py-4">
    <div class="container">
      <a href="/sustentaciones" class="btn btn-light btn-sm mb-3">Volver a Sustentaciones</a>
      <h1 class="display-6 fw-bold"><%= sustentacion.nombreGrupo %></h1>
      <% if (sustentacion.destacada) { %>
        <span class="badge bg-warning text-dark fs-6">Proyecto Destacado</span>
      <% } %>
    </div>
  </header>

  <!-- Menú -->
  <%- include('menu') %>

  <!-- Contenido Principal -->
  <main class="container my-5">
    <div class="row">
      <!-- Imagen Principal -->
      <div class="col-lg-5 mb-4">
        <div class="card shadow-sm">
          <img src="/img/<%= sustentacion.imagen %>" class="card-img-top sustentacion-img-large" alt="<%= sustentacion.nombreGrupo %>">
          <div class="card-body">
            <h5 class="card-title text-primary"><%= sustentacion.materia %></h5>
          </div>
        </div>
      </div>

      <!-- Detalles -->
      <div class="col-lg-7">
        <!-- Información del Grupo -->
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Información del Grupo</h4>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <strong>Nombre del Grupo:</strong>
              <p class="lead mb-0"><%= sustentacion.nombreGrupo %></p>
            </div>
            <div class="mb-3">
              <strong>Materia:</strong>
              <p class="mb-0"><%= sustentacion.materia %></p>
            </div>
            <div>
              <strong>Integrantes:</strong>
              <ul class="list-group list-group-flush mt-2">
                <% sustentacion.integrantes.forEach(integrante => { %>
                  <li class="list-group-item"><%= integrante %></li>
                <% }) %>
              </ul>
            </div>
          </div>
        </div>

        <!-- Descripción del Proyecto -->
        <div class="card shadow-sm">
          <div class="card-header bg-success text-white">
            <h4 class="mb-0">Descripción del Proyecto</h4>
          </div>
          <div class="card-body">
            <p class="card-text text-justified">
              <%= sustentacion.contenido %>
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Botones de Navegación -->
    <div class="row mt-5">
      <div class="col-12 text-center">
        <a href="/sustentaciones" class="btn btn-primary btn-lg me-2">
          Ver Todas las Sustentaciones
        </a>
        <a href="/destacadas" class="btn btn-warning btn-lg">
          Ver Destacadas
        </a>
      </div>
    </div>
  </main>

  <!-- Pie de Página -->
  <footer class="bg-dark text-white py-4 mt-5">
    <div class="container text-center">
      <p class="mb-0">© 2025 Proyectos Integradores - Universidad</p>
      <p class="mb-0 small">Jornada de Sustentaciones Académicas</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>
</body>

</html>